				{
					"name": "login user",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Test 1: Check of de request succesvol was\r",
									"pm.test(\"Login successful - Status 200\", function () {\r",
									"    pm.response.to.have.status(200);\r",
									"});\r",
									"\r",
									"// Test 2: Check response structure\r",
									"pm.test(\"Response contains required fields\", function () {\r",
									"    var jsonData = pm.response.json();\r",
									"    pm.expect(jsonData).to.have.property('token');\r",
									"    pm.expect(jsonData).to.have.property('username');\r",
									"    pm.expect(jsonData).to.have.property('role');\r",
									"});\r",
									"\r",
									"// Test 3: Token is niet leeg\r",
									"pm.test(\"Token is not empty\", function () {\r",
									"    var jsonData = pm.response.json();\r",
									"    pm.expect(jsonData.token).to.not.be.empty;\r",
									"});\r",
									"\r",
									"// Automatische token opslag (alleen dit blok!)\r",
									"if (pm.response.code === 200) {\r",
									"    var jsonData = pm.response.json();\r",
									"    var token = jsonData.token;\r",
									"    var role = jsonData.role;\r",
									"\r",
									"    // Role-based opslag\r",
									"    if (role === \"ADMIN\") {\r",
									"        pm.collectionVariables.set(\"ADMIN_TOKEN\", token);\r",
									"        console.log(\"✅ Admin token saved\");\r",
									"    } else if (role === \"INSTRUCTOR\") {\r",
									"        pm.collectionVariables.set(\"INSTRUCTOR_TOKEN\", token);\r",
									"        console.log(\"✅ Instructor token saved\");\r",
									"    } else if (role === \"STUDENT\") {\r",
									"        pm.collectionVariables.set(\"STUDENT_TOKEN\", token);\r",
									"        console.log(\"✅ Student token saved\");\r",
									"    }\r",
									"\r",
									"    // Algemene token voor \"Inherit Auth\"\r",
									"    pm.collectionVariables.set(\"jwt_token\", token);\r",
									"    console.log(`Token saved for user: ${jsonData.username} (${role})`);\r",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
